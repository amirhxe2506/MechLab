# Copy this file to .env and adjust as needed for local development.
# .env is git-ignored and must never be committed.

# --- Django core -----------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string-in-every-real-environment
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ----------------------------------------------------------------
# Matches the default credentials in docker-compose.yml at the repo root.
DATABASE_URL=postgresql://mechlab:mechlab@localhost:5432/mechlab

# --- CORS ----------------------------------------------------------------------
# React/Vite dev server origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
